{
	"name": "whatsapp-chatgpt",
	"version": "1.0.0",
	"description": "Whatsapp bot that uses OpenAI's GPT & DALLE to respond to user inputs",
	"main": "dist/index.js",
	"author": "Askrella Software Agency UG (haftungsbeschränkt)",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "npm run typecheck && npm run format:check && npm test",
		"dev": "tsx src/index.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prestart": "npm run build",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"license": "MIT",
	"dependencies": {
		"@ai-sdk/openai": "^4.0.11",
		"@aws-sdk/client-polly": "^3.1085.0",
		"ai": "^7.0.22",
		"dotenv": "^17.4.2",
		"picocolors": "^1.1.1",
		"qrcode": "^1.5.4",
		"whatsapp-web.js": "^1.34.7",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"@types/qrcode": "^1.5.6",
		"prettier": "^3.6.2",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
